# このファイルをコピーして .env.local を作る。.env.local はコミットしない。
#   cp .env.local.example .env.local

# ------------------------------------------------------------------
# 地図表示用の Google Maps API キー（ブラウザに露出する）
# ------------------------------------------------------------------
# NEXT_PUBLIC_ が付く変数はビルド成果物に必ず埋め込まれる。これは避けられないため、
# 秘匿ではなく「制限」で守る。Google Cloud Console で必ず設定すること:
#
#   1. アプリケーションの制限 → ウェブサイト（HTTP リファラー）
#        https://www.ngmix.com/*
#      **パス（/tochisuke/）を含めないこと。** ブラウザは既定のリファラーポリシーで
#      クロスオリジンの要求からパスを落とすため、パス付きの制限は正しい要求まで弾く。
#      開発機からも地図を見るなら http://localhost:3000/* も足す。
#   2. API の制限 → Maps JavaScript API のみ（Geocoding / Places を含めない）
#   3. 割り当て上限（quota cap）と予算アラートを設定し、課金の上限を固定する
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 地図のスタイル ID（Advanced Markers に必須）
# 未設定だと Google の開発用 ID (DEMO_MAP_ID) にフォールバックする。
# 本番では Cloud Console →「マップの管理」で ID を作って設定すること。
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ------------------------------------------------------------------
# ジオコーディング用の API キー（取り込み時のみ・公開しない）
# ------------------------------------------------------------------
# 表示用と必ず分ける。同じキーを兼用すると、公開されるキーに
# ジオコーディング権限が付いてしまう。こちらは NEXT_PUBLIC_ を付けないので
# ビルド成果物には入らない。IP 制限をかけて開発マシンからのみ使う。
#
# bun run geocode は、住所で解決できない店を店名で引く段（Places API）を持つ。
# このキーで両方を叩くため、Cloud Console で以下を済ませておくこと:
#
#   1. API とサービス → 「Places API (New)」（places.googleapis.com）を有効化
#      旧「Places API」（places-backend.googleapis.com）とは別のサービス。
#   2. このキーの API の制限に「Places API (New)」を追加（Geocoding API と併記）
#
# 未設定でも geocode は止まらない。店名で引く段だけを飛ばして警告を出す。
GEOCODING_API_KEY=

# 店名検索（Places API）に別のキーを使いたい場合のみ設定する。
# 未設定なら GEOCODING_API_KEY を使う。
# PLACES_API_KEY=

# ------------------------------------------------------------------
# 公開パス（通常は変更しない）
# ------------------------------------------------------------------
# next.config.ts が既定値 /tochisuke を持つため、通常は未設定でよい。
# ルート直下で確認したい場合のみ空文字を指定する。
# NEXT_PUBLIC_BASE_PATH=/tochisuke
